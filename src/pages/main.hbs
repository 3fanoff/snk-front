{{#> layout/base-layout}}
    {{> breadcrumbs }}

    <!-- Каталог плитки -->
    {{> catalog-grid }}
    <!-- Сопровождение на всех этапах = Карусель -->
    {{> card-carousel-escort }}
    <!-- Собственный сервисный центр basic-text-box + icon -->
    {{> service-center }}
    <!-- Популярное оборудование = карусель с выравниванием в центре -->
    {{> card-carousel-popular }}
    <!-- Синяя форма = color-box форма и текст -->
    {{> color-box-form }}
    <!-- О компании = текст и basic-text-box + icon-center-->
    {{> about-box }}
    <!-- Карта -->
    {{> map-box }}
    <!-- Карусель логотипов -->
    {{> logos-carousel }}
    <!-- Оборудование по типу применения = кнопки -->
    {{> buttons-line }}
    <!-- Сертификат и гарантии = figure + icons -->
    {{> guarantees }}
    <!-- Каталог и пагинация -->
    {{> catalog-paging }}
    <!-- Маленькие color-box -->
    {{> color-box-minicards }}
    <!-- Табы -->
    {{> tabs }}
    <!-- FAQ -->
    {{> faq-accordion heading="Часто задаваемые&nbsp;<b data-xs></b><span>вопросы</span>" questions=data.faq }}
    <!-- Video -->
    {{> video-list }}
    <!-- Свой сервисный центр -->
    {{> self-service }}
    <!-- Прямой доступ & НАША Миссия -->
    {{> about-cards }}
    <!-- Контакты и адреса -->
    {{> addresses }}
    <!-- Реквизиты -->
    {{> requisites }}
    <!-- Филиал -->
    {{> branch }}
    <!-- Какую демонстрацию выбрать? -->
    {{> card-demo-types }}
    <!-- Перечень этапов -->
    {{!> stage-list heading="Мы работаем оперативно и прозрачно"}}



{{/layout/base-layout}}
