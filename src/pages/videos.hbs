{{#> layout/base-layout}}
    {{> breadcrumbs }}

    <section class="container layout-container">
        <h1 class="layout-title">Видео по приборам</h1>
        <p class="layout-subtitle">В видео мы показываем то, что сложно описать словами: настройка, измерение и сравнение моделей,<br>
            как выглядит экран во время анализа и как быстро появляется результат</p>

        <ul class="nav nav-pills tag-pills mb-6">
            <li class="nav-item">
                <a class="nav-link active" href="#">Все</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Обзор</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Сравнение</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Металлтест</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Стил</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Драги</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Металлы</a>
            </li>
        </ul>

        <div class="grid gap-5 row-gap-lg-6 column-gap-lg-3">
            {{#times 4}}
                <div class="player-preview player-preview--mini-item g-col-12 g-col-lg-4 js-video-gallery-item"
                     data-src="https://rutube.ru/video/embed/a6f1b5ada409ac3b4971fc029e486b18?autoplay=true"
                     data-poster="../content/video_preview_1.png"
                     data-iframe="true"
                     data-lg-size="720-360"
                     data-sub-html="<p>Определение марки стали без головной боли - <b>СТИЛ-М1</b></p>"
                >
                    <div class="player-preview__nav">
                        <span class="play-btn"></span>
                        <img src="../content/video_preview_1.png" width="554" height="332" alt="preview 1" />
                        <!--<img src="https://imgplaceholdr.com/554x332/cccccc/969696/webp?text_size=40" width="554" height="332" alt="preview 1" />-->
                    </div>
                    <div class="player-preview__desc mb-0 d-flex d-jc-between d-ai-center">
                        <div>
                            <span class="h4 m-0 clamped-text">Определение марки стали без головной боли - СТИЛ-М1</span>
                        </div>
                        <div class="player-preview__time badge bg-primary lh-1">02:45</div>
                    </div>
                </div>
            {{/times}}
        </div>

        <ul class="pagination d-jc-center mt-6" aria-label="Навигация по страницам">
            <li class="page-item"><a href="#" class="page-link"><i class="i-left page-link-i"></i></a></li>
            <li class="page-item active" aria-current="page"><a href="#" class="page-link">1</a></li>
            <li class="page-item" aria-current="page"><a href="#" class="page-link">2</a></li>
            <li class="page-item" aria-current="page"><a href="#" class="page-link">3</a></li>
            <li class="page-item" aria-current="page"><span class="page-div">...</span></li>
            <li class="page-item" aria-current="page"><a href="#" class="page-link">10</a></li>
            <li class="page-item"><a href="#" class="page-link"><i class="i-right page-link-i"></i></a></li>
        </ul>
    </section>


{{/layout/base-layout}}