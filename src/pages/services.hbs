{{#> layout/base-layout}}
    {{> breadcrumbs }}

    <section class="container layout-container">
        <h1 class="layout-title h2">Услуги</h1>
        <p class="layout-subtitle">Надёжность, подтверждённая сервисом: <br>полное сопровождение вашего оборудования</p>
        <div class="grid gap-3 row-gap-lg-6 column-gap-lg-3">
            <div class="g-col-12 g-col-lg-4 card">
                <div class="card-img ratio ratio-16x9 overflow-hidden">
                    <img src="../content/serv_page_1.jpg" class="" alt="serv1" width="365" height="216" />
                </div>
                <div class="card-body">
                    <p class="card-title h3">Ремонт и обслуживание</p>
                    <p class="card-text">Сервис, который продлевает жизнь вашему оборудованию без простоев</p>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-primary d-block">Подробнее</a>
                </div>
            </div>
            <div class="g-col-12 g-col-lg-4 card">
                <div class="card-img ratio ratio-16x9 overflow-hidden">
                    <img src="../content/serv_page_2.jpg" class="" alt="serv2" width="365" height="216" />
                </div>
                <div class="card-body">
                    <p class="card-title h3">Бесплатное демо</p>
                    <p class="card-text">Убедитесь в правильном решении до покупки. Протестируйте прибор</p>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-primary d-block">Подробнее</a>
                </div>
            </div>
            <div class="g-col-12 g-col-lg-4 card">
                <div class="card-img ratio ratio-16x9 overflow-hidden">
                    <img src="../content/serv_page_3.jpg" class="" alt="serv3" width="365" height="216" />
                </div>
                <div class="card-body">
                    <p class="card-title h3">Поверка оборудования</p>
                    <p class="card-text">Официальная поверка с выдачей свидетельства</p>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-primary d-block">Подробнее</a>
                </div>
            </div>
            <div class="g-col-12 g-col-lg-4 card">
                <div class="card-img ratio ratio-16x9 overflow-hidden">
                    <img src="../content/serv_page_4.jpg" class="" alt="serv4" width="365" height="216" />
                </div>
                <div class="card-body">
                    <p class="card-title h3">Обучение операторов</p>
                    <p class="card-text">Грамотное управление оборудованием начинается с обучения операторов</p>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-primary d-block">Подробнее</a>
                </div>
            </div>
            <div class="g-col-12 g-col-lg-4 card">
                <div class="card-img ratio ratio-16x9 overflow-hidden">
                    <img src="../content/serv_page_5.jpg" class="" alt="serv5" width="365" height="216" />
                </div>
                <div class="card-body">
                    <p class="card-title h3">Рассрочка</p>
                    <p class="card-text">Рассрочка на любое оборудование без переплат и предоплат</p>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-primary d-block">Подробнее</a>
                </div>
            </div>
            <div class="g-col-12 g-col-lg-4 card">
                <div class="card-img ratio ratio-16x9 overflow-hidden">
                    <img src="../content/serv_page_6.jpg" class="" alt="serv6" width="365" height="216" />
                </div>
                <div class="card-body">
                    <p class="card-title h3">Аренда приборов</p>
                    <p class="card-text">Работает как ваш — но без затрат на покупку и обслуживание</p>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-primary d-block">Подробнее</a>
                </div>
            </div>
        </div>
    </section>

    {{> color-box-form }}
    <!-- Карта -->
    {{> map-box }}
    <!-- Карусель логотипов -->
    {{> logos-carousel heading="Где работает наше оборудование" }}

{{/layout/base-layout}}