<section class="container layout-container">
    <h2 class="layout-title">Свой сервисный центр.<b data-xs></b>Без посредников</h2>
    <p class="layout-subtitle">Все используемые запчасти — оригинальные или сертифицированные аналоги с документацией</p>
    <div class="grid-gallery">
        {{#times 2}}
            <div class="grid-gallery__item ratio">
                <img src="../../content/ser1_1.png" width="347" height="260" alt="ser 1-1" loading="lazy">
            </div>
            <div class="grid-gallery__item ratio vertical">
                <img src="../../content/ser4_1.png" width="201" height="259" alt="ser 4-1" loading="lazy">
            </div>
            <div class="grid-gallery__item ratio">
                <img src="../../content/ser2_1.png" width="346" height="260" alt="ser 2-1" loading="lazy">
            </div>
            <div class="grid-gallery__item ratio vertical">
                <img src="../../content/ser5_1.png" width="200" height="260" alt="ser 5-1" loading="lazy">
            </div>
        {{/times}}
    </div>
</section>