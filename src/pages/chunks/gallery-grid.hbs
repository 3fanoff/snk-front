<div class="grid-gallery {{className}}"{{#if isCarousel}} data-carousel{{/if}}>
    {{#times 2}}
        {{#each ../images}}
            <div class="grid-gallery__item ratio{{#if (mt h w)}} vertical{{/if}}"{{#if ../../isCarousel}} data-carousel-item{{/if}}>
                <img src="{{src}}" width="{{w}}" height="{{h}}" alt="photo {{@index}}" loading="lazy" data-src="{{src}}">
            </div>
        {{/each}}
    {{/times}}
</div>
{{#if isCarousel}}
    <ul class="indicator-list pt-4" data-carousel-nav>
        <li class="active">1</li>
    </ul>
{{/if}}