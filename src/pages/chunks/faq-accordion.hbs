<section class="container layout-container">
    <h2 class="layout-title">{{{heading}}}</h2>
    <div class="accordion js-accordion" id="faq">
        {{#each questions}}
            <div class="accordion-item">
                <button
                        class="accordion-button gradient-1{{#unless (eq @index 0)}} collapsed{{/unless}}"
                        type="button"
                        data-count="0{{math 'plus' @index 1}}"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq-{{@index}}"
                        aria-expanded="true"
                        aria-controls="faq-{{@index}}"
                >
                    {{{question}}}
                </button>
                <div id="faq-{{@index}}" class="accordion-collapse collapse{{#ifeq @index 0}} show{{/ifeq}}" data-bs-parent="#faq">
                    <div class="accordion-body">
                    <span>{{{answer}}}</span>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
</section>