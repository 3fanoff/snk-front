{{#> layout/base-layout}}
    {{> breadcrumbs }}

    {{> card-comparision
            heading="Поверка анализаторов"
            heading_tag="h1"
            subtitle="Прибор снова будет допущен к работе — с протоколом и отметкой в паспорте. <br>Работаем с госповерителями. Средний срок поверки — 3 дня" }}

    {{> stage-list stages=data.stage heading="мы поверяем быстро и&nbsp;прозрачно"}}

    <!-- Карусель логотипов -->
    {{> brands-carousel
            heading="Нам доверяют заводы и&nbsp;лаборатории по всей России"
            subtitle="Более 2000 предприятий уже прошли поверку у нас. Результаты признаны Росаккредитацией"}}

    {{> what-if
            heading="«А что, если поверка не нужна, а прибор действительно врёт?»"
            btn="Заказать поверку или диагностику"
            text="Мы проведём диагностику и при необходимости — отремонтируем. А уже после ремонта — поверим и оформим документы. Всё в одном месте."}}

    <!-- Синяя форма = color-box форма и текст -->
    {{> color-box-form heading=data.colorbox.heading list=data.colorbox.list alttext=data.colorbox.alt}}

{{/layout/base-layout}}